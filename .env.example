# Copy to .env (gitignored) and fill in real values.
# Generate passwords with: openssl rand -base64 18

MYSQL_DATABASE=scenery

# Emergencies only — no service uses root.
MYSQL_ROOT_PASSWORD=change-me

# Liquibase migrations: DDL + DML on ${MYSQL_DATABASE} only.
MYSQL_MIGRATOR_USER=scenery_migrator
MYSQL_MIGRATOR_PASSWORD=change-me

# API / app runtime: DML only (cannot CREATE/ALTER/DROP).
MYSQL_APP_USER=scenery_app
MYSQL_APP_PASSWORD=change-me
