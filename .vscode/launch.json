{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to API in Docker (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "/srv"
        }
      ],
      "justMyCode": true
    }
  ]
}
